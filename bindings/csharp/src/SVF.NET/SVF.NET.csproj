<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;netstandard2.0</TargetFrameworks>
    <PackageId>SVF.NET</PackageId>
    <Version>1.0.1</Version>
    <Authors>SVF-tools, dg1474</Authors>
    <Company>SVF-tools</Company>
    <Description>.NET / C# bindings and native runtime wrapper for SVF (Static Value-Flow Analysis Framework for Source Code / LLVM Bitcode).</Description>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/SVF-tools/SVF</PackageProjectUrl>
    <RepositoryUrl>https://github.com/SVF-tools/SVF.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>static-analysis;llvm;pointer-analysis;security;value-flow;csharp;dotnet</PackageTags>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\..\README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <!-- Multi-platform runtimes packaging -->
  <!-- 1. Staged multi-RID directory if populated -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\..\..\runtimes')">
    <None Include="$(MSBuildThisFileDirectory)..\..\..\..\runtimes\**\*" Pack="true" PackagePath="runtimes" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 2. Windows x64 native binaries from local Release-build -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\..\..\Release-build\bin\wpa.exe')">
    <None Include="$(MSBuildThisFileDirectory)..\..\..\..\Release-build\bin\wpa.exe" Pack="true" PackagePath="runtimes\win-x64\native" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(MSBuildThisFileDirectory)..\..\..\..\Release-build\bin\saber.exe" Pack="true" PackagePath="runtimes\win-x64\native" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(MSBuildThisFileDirectory)..\..\..\..\Release-build\lib\extapi.bc" Pack="true" PackagePath="runtimes\win-x64\native" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 3. Linux x64 native binaries from local Release-build if built on Linux -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\..\..\Release-build\bin\wpa') And !Exists('$(MSBuildThisFileDirectory)..\..\..\..\Release-build\bin\wpa.exe')">
    <None Include="$(MSBuildThisFileDirectory)..\..\..\..\Release-build\bin\wpa" Pack="true" PackagePath="runtimes\linux-x64\native" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(MSBuildThisFileDirectory)..\..\..\..\Release-build\bin\saber" Pack="true" PackagePath="runtimes\linux-x64\native" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(MSBuildThisFileDirectory)..\..\..\..\Release-build\lib\extapi.bc" Pack="true" PackagePath="runtimes\linux-x64\native" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
